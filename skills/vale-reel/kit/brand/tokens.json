{
  "name": "Vale Studio",
  "feel": [
    "premium",
    "warm",
    "considered"
  ],
  "never": [
    "AI slop",
    "generic creative agency"
  ],
  "color": {
    "ink": "#141313",
    "paper": "#FFFFFF",
    "umber": "#5A504A",
    "stone": "#9C8979",
    "paperWarm": "#F4F0EC",
    "stoneLight": "#BBAEA2",
    "track": "#2E2A28",
    "positive": "#8FC1A0",
    "negative": "#E8968A"
  },
  "font": {
    "caption": {
      "family": "Hanken Grotesk",
      "weight": 600
    },
    "emphasis": {
      "family": "Newsreader",
      "weight": 400,
      "style": "italic"
    },
    "title": {
      "family": "Newsreader",
      "weight": 400
    },
    "name": {
      "family": "Newsreader",
      "weight": 500
    },
    "label": {
      "family": "DM Mono",
      "weight": 500,
      "transform": "uppercase",
      "tracking": 0.08
    }
  },
  "captions": {
    "vertical": {
      "frame": [
        1080,
        1920
      ],
      "sizePx": 64,
      "maxChars": 24,
      "maxLines": 2,
      "baselineY": 1340,
      "safe": {
        "x": [
          90,
          990
        ],
        "y": [
          260,
          1500
        ]
      },
      "plateTopY": 1470
    },
    "horizontal": {
      "frame": [
        1920,
        1080
      ],
      "sizePx": 52,
      "maxChars": 42,
      "maxLines": 2,
      "baselineY": 940,
      "safe": "90% title safe"
    },
    "color": "#FFFFFF",
    "lineHeight": 1.15,
    "shadow": {
      "color": "#141313",
      "opacity": 0.45,
      "offsetPx": 0,
      "blurPx": 6,
      "use": "fallback when a plate would cover something important"
    },
    "plate": {
      "color": "#5A504A",
      "radiusPx": 3,
      "paddingPx": [
        16,
        10
      ]
    },
    "emphasisAtMostOncePerCaptions": 3,
    "animation": "none",
    "style": "karaoke-plate",
    "wordsPerCaption": [
      3,
      5
    ],
    "font": {
      "family": "Newsreader",
      "weight": 400,
      "sizePx": 54
    },
    "spokenColor": "#F4F0EC",
    "upcomingColor": "#C2B5A6"
  },
  "lowerThird": {
    "nameSizePx": {
      "vertical": 60,
      "horizontal": 48
    },
    "roleSizePx": {
      "vertical": 24,
      "horizontal": 20
    },
    "plate": {
      "color": "#5A504A",
      "altColorOnLightFootage": "#141313",
      "opacity": 1,
      "radiusPx": 2,
      "paddingPx": [
        24,
        16
      ]
    },
    "rule": {
      "color": "#9C8979",
      "widthPx": 4,
      "side": "left"
    },
    "x": {
      "vertical": 90,
      "horizontal": 96
    },
    "holdSeconds": 4,
    "in": {
      "durationMs": 200,
      "risePx": 8,
      "ease": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "out": {
      "durationMs": 120,
      "ease": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "y": {
      "verticalTightFraming": 1470
    }
  },
  "titleCard": {
    "background": "#141313",
    "text": "#F4F0EC",
    "sizePx": {
      "vertical": 88,
      "horizontal": 96
    },
    "maxLines": {
      "vertical": 3,
      "horizontal": 2
    },
    "holdSeconds": [
      1.5,
      2.5
    ],
    "transition": "cut"
  },
  "endCard": {
    "background": "#141313",
    "text": "#F4F0EC",
    "holdSeconds": 3
  },
  "edit": {
    "transitions": "hard cuts only",
    "punchInScale": [
      1.1,
      1.15
    ],
    "punchInMinGapSeconds": 20
  },
  "audio": {
    "integratedLufs": -14,
    "truePeakDbtp": -1,
    "highPassHz": 80,
    "musicUnderVoiceLu": [
      20,
      24
    ],
    "sfxOnText": false
  },
  "keywordTitle": {
    "font": "Newsreader",
    "weight": 400,
    "color": "#F4F0EC",
    "sizePx": [
      220,
      320
    ],
    "holdSeconds": [
      0.8,
      1.5
    ],
    "minGapSeconds": 6,
    "position": "upper half, centred"
  },
  "titleStack": {
    "line1": {
      "font": "Hanken Grotesk",
      "weight": 700,
      "transform": "uppercase"
    },
    "line2": {
      "font": "Newsreader",
      "style": "italic",
      "endsWith": "."
    },
    "plate": "#5A504A",
    "x": 90
  },
  "dateLine": {
    "font": "DM Mono",
    "transform": "uppercase",
    "tracking": 0.2,
    "separator": " \u00b7 ",
    "color": "#F4F0EC",
    "opacity": 0.7
  },
  "splitScreen": {
    "top": [
      1080,
      960
    ],
    "bottom": [
      1080,
      960
    ],
    "captionsAt": "seam"
  },
  "references": "references/NOTES.md",
  "graphicsPalettes": {
    "vale": {
      "plate": "#5A504A",
      "text": "#F4F0EC",
      "dim": "#C2B5A6",
      "accent": "#E6D5BC",
      "ink": "#141313",
      "card": "#F4F0EC"
    },
    "forest": {
      "plate": "#183429",
      "text": "#F3EDE1",
      "dim": "#BFB2A1",
      "accent": "#C4AC5C",
      "ink": "#141313",
      "card": "#F3EDE1"
    }
  }
}